# ==============================================================================
# Smart Fridge AI - Environment Configuration
# ==============================================================================

# Core Settings
PROJECT_NAME="Smart Fridge"
API_V1_STR="/api"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_FOR_LOCAL_DEVELOPMENT
ACCESS_TOKEN_EXPIRE_MINUTES=10080
APP_URL="http://localhost:5173"

# Database Configuration (SQLite default; Postgres supported)
DATABASE_URL="sqlite:///../smart_fridge.db"

# ==============================================================================
# Telegram Bot API Notifications (Primary Provider)
# ==============================================================================
# Token from @BotFather in Telegram (format: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=""
# Your personal or group chat ID (from @userinfobot or @raw_data_bot)
TELEGRAM_CHAT_ID=""
TELEGRAM_ENABLED=true

# ==============================================================================
# Legacy SMS Alert Settings (Twilio - Optional)
# ==============================================================================
TWILIO_ENABLED=false
SMS_ENABLED=false
SMS_PROVIDER="telegram"

# Recipient Mobile Number (E.164 format or 10-digit Indian mobile number)
# 10 digits starting with 6-9 will be automatically normalized to +91 country code
TWILIO_TO_NUMBER="+15551234567"
# Legacy alias for TWILIO_TO_NUMBER
SMS_TO_NUMBER="+15551234567"

# Twilio Credentials (from https://console.twilio.com)
# NOTE: Never commit actual credentials to Git!
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_FROM_NUMBER="+15551234567"
# Optional: Twilio Messaging Service SID (MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
TWILIO_MESSAGING_SERVICE_SID=""

# Spoilage Alert Repeat Timing
# Spoilage reminder interval in minutes (default: 120 = 2 hours)
SMS_REMINDER_INTERVAL_MINUTES=120
SMS_DEFAULT_REPEAT_INTERVAL_MINUTES=120
# Cooldown between messages to prevent spam (in seconds)
SMS_COOLDOWN_SECONDS=60

# Fast2SMS Alternative (Optional for India)
FAST2SMS_API_KEY=""
FAST2SMS_DLT_TE_ID=""

# ==============================================================================
# Email Provider Settings (SMTP / Resend / Brevo)
# ==============================================================================
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_NAME="Smart Fridge Assistant"
EMAILS_FROM_EMAIL=""
RESEND_API_KEY=""
BREVO_API_KEY=""

# ==============================================================================
# Web Push (VAPID) Settings
# ==============================================================================
WEB_PUSH_ENABLED=true
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY_HERE"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY_HERE"
VAPID_CLAIM_EMAIL="admin@smartfridge.local"