{
  "name": "smart-fridge-ai",
  "version": "1.0.0",
  "description": "Smart Fridge AI - Food Management, Freshness AI, Barcode Scanner & Spoilage SMS Alert System",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
